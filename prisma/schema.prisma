// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Spot {
  id            Int      @id @default(autoincrement())

  // ===== 投稿内容 =====
  place         String
  bloom         Int
  weather       String?
  comment       String?
  imageUrl      String?
  imageHash     String?

  // ===== 投稿者（匿名ID / cookieベース）=====
  contributorId String

  // ===== 日時 =====
  createdAt     DateTime @default(now())

  // ===== インデックス =====
  @@index([place])
  @@index([createdAt])
  @@index([contributorId])
}
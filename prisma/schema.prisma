// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Spot {
  id        Int      @id @default(autoincrement())
  place     String
  bloom     Int
  weather   String?

  comment   String?
  imageUrl  String?
  imageHash String?

  createdAt DateTime @default(now())

  @@index([place])
  @@index([createdAt])
}
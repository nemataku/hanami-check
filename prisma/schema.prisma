// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

//////////////////////////////////////////////////////
// 投稿者（匿名ユーザー）
//////////////////////////////////////////////////////
model Contributor {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique
  createdAt DateTime @default(now())

  spots     Spot[]

  @@index([createdAt])
}

//////////////////////////////////////////////////////
// 投稿データ（花見・イベント・スポット共通）
//////////////////////////////////////////////////////
model Spot {
  id            Int      @id @default(autoincrement())

  place         String
  bloom         Int
  weather       String?

  comment       String?
  imageUrl      String?
  imageHash     String?

  contributorId Int?
  contributor   Contributor? @relation(fields: [contributorId], references: [id])

  createdAt     DateTime @default(now())

  @@index([place])
  @@index([createdAt])
  @@index([contributorId])
}
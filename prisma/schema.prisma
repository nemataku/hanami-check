// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * 投稿者（匿名・Cookieベース想定）
 */
model Contributor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  spots     Spot[]

  @@index([createdAt])
}

/**
 * 投稿データ
 */
model Spot {
  id            Int      @id @default(autoincrement())

  place         String
  bloom         Int
  weather       String?

  comment       String?
  imageUrl      String?
  imageHash     String?

  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id])

  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  @@index([place])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([contributorId])
}
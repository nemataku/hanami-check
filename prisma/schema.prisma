// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Category {
  SHOPPING
  PARK
  FOOD
  EVENT
  PARKING
  HANAMI
  SCENIC
  PUBLIC
}

enum CrowdLevel {
  EMPTY        // 空いている
  LIGHT        // やや混雑
  CROWDED      // 混雑
  FULL         // 満員
  RESTRICTED   // 入場規制
}

enum ParkingLevel {
  AVAILABLE    // 空きあり
  LIGHT        // やや混雑
  CROWDED      // 混雑
  FULL         // 満車
}

enum BusinessStatus {
  OPEN
  BREAK
  CLOSED
  HOLIDAY
}

enum FlowerPreset {
  SAKURA
  UME
  OTHER
}

model Contributor {
  id        String   @id
  createdAt DateTime @default(now())
  spots     Spot[]
}

model Spot {
  id            Int          @id @default(autoincrement())

  // 共通
  category      Category     @default(HANAMI)
  place         String

  // 花見（既存）
  bloom         Int?         // 0..6（花見のみ必須扱い）
  weather       String?

  // 共通（既存）
  comment       String?
  imageUrl      String?
  imageHash     String?

  // 混雑（多くのカテゴリで使用）
  crowd         CrowdLevel?

  // 駐車場
  parkingLevel  ParkingLevel?
  parkingName   String?

  // 商業施設 / 飲食 / 公園
  shopName        String?
  attractionName  String?
  businessStatus  BusinessStatus?
  openTime        String?   // "HH:mm"
  closeTime       String?   // "HH:mm"

  // 待ち時間（公園・公共施設）
  waitMinutes   Int?

  // イベント
  eventName     String?
  eventStart    String?     // "HH:mm"
  eventEnd      String?     // "HH:mm"

  // 花見：花の種類
  flowerPreset  FlowerPreset?
  flowerOther   String?

  // 投稿者
  contributorId String?
  contributor   Contributor? @relation(fields: [contributorId], references: [id])

  createdAt     DateTime     @default(now())

  @@index([place])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@index([contributorId])
}